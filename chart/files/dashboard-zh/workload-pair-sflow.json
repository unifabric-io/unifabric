  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "按交换机的 src 到 dst 流量",
      "description": "源工作负载到目的工作负载的流量速率，按观测交换机拆分。",
      "datasource": {
        "type": "elasticsearch",
        "uid": "unifabric-sflow-elasticsearch"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "unifabric-sflow-elasticsearch"
          },
          "query": "src_workload:\"${src_workload}\" AND dst_workload:\"${dst_workload}\"",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "rate",
              "field": "scaled_bytes",
              "settings": {
                "unit": "second"
              }
            }
          ],
          "bucketAggs": [
            {
              "id": "3",
              "type": "terms",
              "field": "sampler_ip",
              "settings": {
                "order": "desc",
                "orderBy": "_count",
                "size": "10",
                "min_doc_count": "1"
              }
            },
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0",
                "trimEdges": "0"
              }
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
