        "type": "elasticsearch",
        "uid": "unifabric-sflow-elasticsearch"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "unifabric-sflow-elasticsearch"
          },
          "query": "(src_workload:\"${workload}\" OR dst_workload:\"${workload}\")",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "cardinality",
              "field": "sampler_ip"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "365d",
                "min_doc_count": "1"
              }
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
